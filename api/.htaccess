# Bloque l’accès HTTP aux fichiers sensibles (.env, config.php, logs, etc.)
<FilesMatch "(?i)^(\.env.*|config\.php.*|composer\.(json|lock)|.*\.(log|sql|md|sh|yml|yaml))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes -MultiViews

