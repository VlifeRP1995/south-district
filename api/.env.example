# South District RP - Template d'environnement
# Dupliquez ce fichier vers api/.env et renseignez vos véritables identifiants

DB_HOST="127.0.0.1"
DB_NAME="southdistrict"
DB_USER="southdistrict"
DB_PASS="your_db_password_here"

APP_URL="https://www.south-district.fr"

# Identifiants Discord OAuth & Bot
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_SECRET="your_discord_client_secret"
DISCORD_GUILD_ID="your_discord_guild_id"
DISCORD_BOT_TOKEN="your_discord_bot_token"
BOT_API_KEY="your_bot_api_key"
DISCORD_CANDIDATURE_WEBHOOK="https://discord.com/api/webhooks/..."
